{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageS3Website",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutBucketWebsite",
        "s3:GetBucketWebsite",
        "s3:DeleteBucketWebsite",
        "s3:PutBucketPolicy",
        "s3:GetBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketAcl",
        "s3:GetBucketAcl",
        "s3:PutBucketCORS",
        "s3:GetBucketCORS",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketLogging",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketTagging",
        "s3:GetAccelerateConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::nikolaydimitrov.dev-frontend",
        "arn:aws:s3:::nikolaydimitrov.dev-frontend/*"
      ]
    },
    {
      "Sid": "PreventBucketDestruction",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": "arn:aws:s3:::nikolaydimitrov.dev-frontend"
    },
    {
      "Sid": "ManageTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::nikolaydimitrov-terraform-state-bucket",
        "arn:aws:s3:::nikolaydimitrov-terraform-state-bucket/*"
      ]
    },
    {
      "Sid": "PreventStateFileDeletion",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::nikolaydimitrov-terraform-state-bucket/*.tfstate"
    },
    {
      "Sid": "ManageLambdaAndApiGateway",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:PublishVersion",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:GetFunctionCodeSigningConfig",
        "apigateway:*"
      ],
      "Resource": [
        "arn:aws:lambda:*:000000000000:function:geminiChatFunction",
        "arn:aws:lambda:*:000000000000:function:sendEmailFunction",
        "arn:aws:apigateway:*::/apis/*",
        "arn:aws:apigateway:*::/restapis/*"
      ]
    },
    {
      "Sid": "ManageCloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": [
        "arn:aws:cloudfront::000000000000:distribution/E2XZPLP9E3TCRM",
        "arn:aws:cloudfront::000000000000:origin-access-control/*"
      ]
    },
    {
      "Sid": "ManageSpecificIAMRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:DeleteRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PassRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::000000000000:role/GitHubActionsWorkflowRole",
        "arn:aws:iam::000000000000:role/serverless_lambda_role"
      ]
    },
    {
      "Sid": "ManageRoute53AndACM",
      "Effect": "Allow",
      "Action": [
        "route53:GetChange",
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource",
        "acm:ListTagsForCertificate",
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/Z079013913IFJAX1QCJ32",
        "arn:aws:route53:::change/*",
        "arn:aws:acm:*:000000000000:certificate/*",
        "arn:aws:kms:*:000000000000:key/*"
      ]
    },
    {
      "Sid": "ManageLambdaLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:eu-north-1:000000000000:log-group:/aws/lambda/geminiChatFunction",
        "arn:aws:logs:eu-north-1:000000000000:log-group:/aws/lambda/geminiChatFunction:*",
        "arn:aws:logs:eu-north-1:000000000000:log-group:/aws/lambda/sendEmailFunction",
        "arn:aws:logs:eu-north-1:000000000000:log-group:/aws/lambda/sendEmailFunction:*"
      ]
    },
    {
      "Sid": "AllowGlobalReadActions",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:GetHostedZone",
        "acm:ListCertificates",
        "iam:ListOpenIDConnectProviders",
        "iam:GetOpenIDConnectProvider",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    }
  ]
}
